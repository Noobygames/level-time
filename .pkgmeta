# Konfiguration für den BigWigs-Packager (.github/workflows/release.yml).
# Ins Paket kommt alles außer den hier ignorierten Dateien; "make package" packt
# dagegen nur die Dateien aus der .toc plus LICENSE. Neue Nicht-Addon-Dateien hier eintragen.
package-as: LevelTimer

# Load-on-Demand-Archiv (eigener Addon-Ordner neben LevelTimer/, siehe Tracking/JournalArchive.lua)
move-folders:
  LevelTimer/LevelTimer_Archive: LevelTimer_Archive

ignore:
  - tests
  - StreamGoal
  - tools
  - curseforge
  - Makefile
  - README.md
  - ManualToCheck.md
  - ManualToCheck-done.md
  - docs
  - image.png
  - AGENTS.md
  # Lokales Entwickler-Addon (Datensammler und Debug-Werkzeug), wird nie veröffentlicht
  - LevelTimer_DataExtractor
